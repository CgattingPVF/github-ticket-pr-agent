APP_HOST=127.0.0.1
APP_PORT=3060
SECRET_KEY=replace-this-with-a-random-value
DATA_DIR=./data
WORKSPACE_ROOT=./workspaces

# GitHub OAuth (optional: if set, enables "Login with GitHub" button)
# Create an OAuth app at https://github.com/settings/developers
GITHUB_CLIENT_ID=your-client-id-here
GITHUB_CLIENT_SECRET=your-client-secret-here

# Prompts use stdin for Codex/Claude; MergeQuest adapts Kilo to its positional message format.
AGENT_COMMAND=codex exec --sandbox workspace-write -
REVIEW_COMMAND=codex exec --sandbox workspace-write -
CLAUDE_COMMAND=claude -p --model claude-haiku-4-5 --output-format stream-json --verbose --dangerously-skip-permissions
# Adjust this to the Kilo Code CLI command available in your WSL environment.
KILO_COMMAND=/home/claytongatting/.npm-global/bin/kilo run --auto --pure --format json --model kilo/kilo-auto/free
KILO_HY3_COMMAND=/home/claytongatting/.npm-global/bin/kilo run --auto --pure --format json --model kilo/tencent/hy3:free
# Local Qwen 3 4B Q4_K_M runner. Adjust the model path/runner flags for your machine.
QWEN_COMMAND=ollama run qwen3:4b-q4_K_M --think false --hidethinking
EDITOR_COMMAND=code --new-window

COMMAND_TIMEOUT_SECONDS=3600
# Set to 0 only if you intentionally want unlimited model execution.
AGENT_PASS_TIMEOUT_SECONDS=1800
REVIEW_TIMEOUT_SECONDS=900
KILO_REVIEW_TIMEOUT_SECONDS=900
FULL_DELIVERY_TARGET_SECONDS=180
FULL_DELIVERY_PUBLISH_RESERVE_SECONDS=30
MINIMUM_CONFIDENCE=0.80
# Aggressive prompt compression keeps model usage predictable (~1k tokens by default).
PROMPT_MAX_CHARS=4000
MAX_REPAIR_CYCLES=1
MAX_GATE_ATTEMPTS=15
CLOSE_ISSUE_ON_MERGE=false

# On Windows, a desktop notification is shown after a new pull request is created.

# Optional: path to a local repository to use instead of cloning from GitHub
# LOCAL_REPO_PATH=/home/claytongatting/CRM_APP_PVF
